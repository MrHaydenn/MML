{
  "name": "mml",
  "version": "0.4.0",
  "description": "MrHaydenn's Minecraft Launcher — a Windows modpack workspace",
  "author": "MrHaydenn",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:live": "node scripts/check-api.cjs",
    "test:install": "node scripts/check-install.cjs",
    "test:hosting": "electron scripts/check-hosting.cjs",
    "test:account": "electron scripts/check-account.cjs",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "pack": "electron-builder --win --dir --x64 --publish never",
    "preview": "node scripts/preview.cjs",
    "test:updates": "electron scripts/check-updates.cjs"
  },
  "build": {
    "appId": "com.mrhaydenn.mml",
    "productName": "MML",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": {
      "url": "https://github.com/MrHaydenn/MML/releases/latest/download",
      "provider": "generic",
      "channel": "latest"
    },
    "artifactName": "MML-Setup-${version}.${ext}"
  },
  "devDependencies": {
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^30.1.2"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "electron-updater": "^6.8.9",
    "marked": "^18.1.0",
    "yauzl": "^3.4.0"
  }
}
