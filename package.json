{
  "name": "mml",
  "version": "0.1.1",
  "description": "MrHaydenn's Minecraft Launcher — a Windows modpack workspace",
  "author": "MrHaydenn",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:live": "node scripts/check-api.cjs",
    "test:hosting": "electron scripts/check-hosting.cjs",
    "dist": "electron-builder --win nsis --x64 --publish never",
    "pack": "electron-builder --win --dir --x64 --publish never",
    "preview": "node scripts/preview.cjs"
  },
  "build": {
    "appId": "com.mrhaydenn.mml",
    "productName": "MML",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "publish": null
  },
  "devDependencies": {
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3"
  }
}
